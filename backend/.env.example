# Keep server-side credentials and private keys out of source control.
# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 역할별 서명용 개인키
ENTERPRISE_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
# witness
VERIFICATION_PRIVATE_KEY=
# issuer
INSTITUTION_PRIVATE_KEY=

# 온체인 기록용 개인키 ( 컨트랙트 Owner 지갑 개인키 )
ANCHOR_WRITER_PRIVATE_KEY=

# Sepolia 연결
RPC_URL=
CHAIN_ID=11155111
ANCHOR_CONTRACT_ADDRESS=

# 서버 설정
KEY_REGISTRY_PATH=key-registry.json
PORT=3000
ENABLE_DEMOS=false

# Shared database writer lock and daily test-request budget (1-100)
DEMO_DAILY_LIMIT=30
# Vercel: set the public registry JSON here instead of uploading key-registry.json.
# KEY_REGISTRY_JSON=
